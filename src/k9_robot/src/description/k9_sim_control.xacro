<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="k9_sim_control" params="wheel_max_speed">

    <ros2_control name="K9SimSystem" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>

      <joint name="drivewhl_l_joint">
        <command_interface name="velocity">
          <param name="min">${-wheel_max_speed}</param>
          <param name="max">${wheel_max_speed}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="drivewhl_r_joint">
        <command_interface name="velocity">
          <param name="min">${-wheel_max_speed}</param>
          <param name="max">${wheel_max_speed}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="l_ear_joint">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="r_ear_joint">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>

  </xacro:macro>
</robot>
